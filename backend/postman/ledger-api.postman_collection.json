        {
          "name": "Create account A (saves accountA)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('balance is 0', () => pm.expect(pm.response.json().balance === 0).to.be.true);",
                  "pm.collectionVariables.set('accountA', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
